{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./lib/db/dist/index.d.ts"],
      "@workspace/db/schema": ["./lib/db/dist/schema/index.d.ts"],
      "@workspace/api-zod": ["./lib/api-zod/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
